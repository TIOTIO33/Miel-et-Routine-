rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHiveMember(hiveCode) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/hives/$(hiveCode)) &&
        (
          request.auth.uid == get(/databases/$(database)/documents/hives/$(hiveCode)).data.ownerUid ||
          request.auth.uid in get(/databases/$(database)/documents/hives/$(hiveCode)).data.memberUids
        )
      );
    }

    // User documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Hive families
    match /hives/{hiveCode} {
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Children profiles within a hive
      match /children/{childId} {
        allow read, write: if isAuthenticated();
      }

      // Missions within a hive
      match /missions/{missionId} {
        allow read, write: if isAuthenticated();
      }

      // Completions within a hive
      match /completions/{completionId} {
        allow read, write: if isAuthenticated();
      }

      // Rewards within a hive
      match /rewards/{rewardId} {
        allow read, write: if isAuthenticated();
      }

      // Redemptions within a hive
      match /redemptions/{redemptionId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
